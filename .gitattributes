* text=auto
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.Dockerfile text eol=lf
Cargo.lock text eol=lf
processor/requirements.lock text eol=lf
*.pdf binary
# T14 manifests bind exact working-tree bytes, including acquisition line endings.
evals/coverage/** -text
compose.coverage.yaml -text
# T28 freezes bind exact fixture/scorer/browser bytes across checkouts.
experiments/t28/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
frontend/e2e/pointers-live.spec.ts -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# T32 hashes bind exact fixture and request bytes, including original line endings.
experiments/t32/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
