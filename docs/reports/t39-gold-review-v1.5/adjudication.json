          "document_sha256": "55bbfa9052d82fc2074807e0795fc8957a358974ef289c3f0e19e4e8dbb35f85",
          "utf8_start": 310,
          "utf8_end": 453,
          "quote": "Han Chinese were moved to Central Asian areas like Besh Baliq, Almaliq, and Samarqand by the Mongols where they worked as artisans and farmers."
        }
      ],
